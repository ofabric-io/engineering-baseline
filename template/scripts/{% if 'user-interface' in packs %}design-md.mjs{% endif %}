#!/usr/bin/env node
// Generates DESIGN.md (https://github.com/google-labs-code/design.md, version "alpha") from the
// project's token source and the user-interface pack's documents, so coding agents that read
// DESIGN.md see the same visual identity the standards define. DESIGN.md is an output: the token
// source stays the single source (docs/packs/user-interface/design-tokens.md R1, R5).
//   node scripts/design-md.mjs          write DESIGN.md
//   node scripts/design-md.mjs --check  exit 1 if DESIGN.md is missing or out of date
//
// Config: .baseline/ui.json
//   "tokens":     { "<theme>": "<W3C DTCG JSON file>", ... }   the first theme gives the values
//   "primitives": "<DTCG file>"            optional; merged under every theme for aliases
//   "designMd":   {                        optional
//     "enabled":  true,                    false = no DESIGN.md (the check passes)
//     "path":     "DESIGN.md",
//     "theme":    "<theme>",               which theme's values go in the front matter
//     "primary":  "<token path>",          the token DESIGN.md calls `primary` (its linter wants one)
//     "rounded":  ["radius"],              path segments whose dimensions are corner radii
//     "spacing":  ["space", "spacing"]     path segments whose dimensions are spacing
//   }
// Mapping: semantic tokens only (the primitives file is not listed). $type color -> colors,
// typography -> typography, dimension -> rounded or spacing by path segment, shadow -> listed under
// Elevation & Depth. Token names become kebab-case (`color.action.primary` -> `action-primary`,
// dropping a leading `color`/`colour`). The prose comes from the pack's Parameters answers.
// Absent config, or no "tokens" = nothing to generate: --check passes, a plain run says so.
import { existsSync, readFileSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';
import { pathToFileURL } from 'node:url';

const CONFIG = '.baseline/ui.json';
const PACK = 'docs/packs/user-interface';

const readJson = (p) => JSON.parse(readFileSync(p, 'utf8'));

/** Flattens a DTCG tree into dotted name -> { value, type }. Group `$type` is inherited. */
export function flatten(node, prefix = '', type = null, acc = new Map()) {
  if (!node || typeof node !== 'object') return acc;
  const t = node.$type ?? type;
  if ('$value' in node) {
    acc.set(prefix, { value: node.$value, type: t });
    return acc;
  }
  for (const [k, v] of Object.entries(node)) if (!k.startsWith('$')) flatten(v, prefix ? `${prefix}.${k}` : k, t, acc);
  return acc;
}

function resolve(tokens, name, seen = []) {
  if (seen.includes(name)) throw new Error(`alias cycle: ${[...seen, name].join(' -> ')}`);
  const t = tokens.get(name);
  if (!t) throw new Error(`token "${name}" does not exist`);
  const m = typeof t.value === 'string' && t.value.match(/^\{([^}]+)\}$/);
  if (m) return { ...resolve(tokens, m[1], [...seen, name]), type: t.type ?? resolve(tokens, m[1], [...seen, name]).type };
  if (t.value && typeof t.value === 'object' && !Array.isArray(t.value)) {
    // Composite values may hold aliases in their fields.
    const out = {};
    for (const [k, v] of Object.entries(t.value)) {
      const a = typeof v === 'string' && v.match(/^\{([^}]+)\}$/);
      out[k] = a ? resolve(tokens, a[1], [...seen, name]).value : v;
    }
    return { value: out, type: t.type };
  }
  return t;
}

const hex = (v) => {
  const raw = v && typeof v === 'object' ? v.hex : v;
  if (typeof raw !== 'string' || !/^#([0-9a-f]{3}|[0-9a-f]{6}|[0-9a-f]{8})$/i.test(raw)) throw new Error(`colour ${JSON.stringify(v)} has no hex form`);
  return raw.toLowerCase();
};
const dim = (v) => (v && typeof v === 'object' && 'value' in v ? `${v.value}${v.unit ?? ''}` : String(v));
const kebab = (path) => path.split('.').filter((s, i) => !(i === 0 && /^colou?r$/i.test(s))).join('-').replace(/([a-z0-9])([A-Z])/g, '$1-$2').toLowerCase();

function typography(v) {
  const out = {};
  if (v.fontFamily !== undefined) out.fontFamily = Array.isArray(v.fontFamily) ? v.fontFamily[0] : String(v.fontFamily);
  if (v.fontSize !== undefined) out.fontSize = dim(v.fontSize);
  if (v.fontWeight !== undefined) out.fontWeight = v.fontWeight;
  if (v.lineHeight !== undefined) out.lineHeight = typeof v.lineHeight === 'object' ? dim(v.lineHeight) : v.lineHeight;
  if (v.letterSpacing !== undefined) out.letterSpacing = dim(v.letterSpacing);
  return out;
}

/** The answer of a Parameters row in a pack document: its value, the default, or null. */
function param(doc, name) {
  const p = join(PACK, doc);
  if (!existsSync(p)) return null;
  for (const line of readFileSync(p, 'utf8').split('\n')) {
    const c = line.trim().startsWith('|') ? line.trim().replace(/^\||\|$/g, '').split('|').map((x) => x.trim()) : null;
    if (!c || c[0] !== `\`${name}\``) continue;
    if (/\[\[[^\]]+\]\]/.test(c[1])) return null;
    return c[1] === 'default' ? c[2] : c[1];
  }
  return null;
}
const said = (v) => v ?? '_not decided yet_';

function yamlScalar(v) {
  if (typeof v === 'number') return String(v);
  return `"${String(v).replace(/\\/g, '\\\\').replace(/"/g, '\\"')}"`;
}
function yamlMap(obj, indent = '') {
  return Object.entries(obj).map(([k, v]) => (v && typeof v === 'object'
    ? `${indent}${k}:\n${yamlMap(v, `${indent}  `)}`
    : `${indent}${k}: ${yamlScalar(v)}`)).join('\n');
}

/** Builds DESIGN.md text, or returns { skip: reason }. Throws on a broken token source. */
export function render() {
  if (!existsSync(CONFIG)) return { skip: `${CONFIG} does not exist` };
  const config = readJson(CONFIG);
  const opts = config.designMd ?? {};
  if (opts.enabled === false) return { skip: 'designMd.enabled is false' };
  const themes = Object.entries(config.tokens ?? {});
  if (!themes.length) return { skip: `${CONFIG} lists no token files under "tokens"` };
  const primitives = config.primitives ? flatten(readJson(config.primitives)) : new Map();
  const byTheme = new Map(themes.map(([theme, file]) => [theme, flatten(readJson(file))]));
  const main = opts.theme && byTheme.has(opts.theme) ? opts.theme : themes[0][0];
  const own = byTheme.get(main);
  const all = (theme) => new Map([...primitives, ...byTheme.get(theme)]);
  const roundedSeg = opts.rounded ?? ['radius', 'radii', 'rounded', 'corner'];
  const spacingSeg = opts.spacing ?? ['space', 'spacing', 'gap'];
  const hasSeg = (path, segs) => path.split('.').some((s) => segs.includes(s.toLowerCase()));

  const colors = {};
  const colorRows = [];
  const typo = {};
  const rounded = {};
  const spacing = {};
  const shadows = [];
  for (const [path] of own) {
    const { value, type } = resolve(all(main), path);
    const name = kebab(path);
    if (type === 'color') {
      colors[name] = hex(value);
      colorRows.push([name, path, ...themes.map(([t]) => { try { return hex(resolve(all(t), path).value); } catch { return '—'; } })]);
    } else if (type === 'typography' && value && typeof value === 'object') typo[name] = typography(value);
    else if (type === 'dimension' && hasSeg(path, roundedSeg)) rounded[name] = dim(value);
    else if (type === 'dimension' && hasSeg(path, spacingSeg)) spacing[name] = dim(value);
    else if (type === 'shadow') shadows.push(name);
  }
  if (opts.primary) {
    colors.primary = hex(resolve(all(main), opts.primary).value);
  }

  let name = 'Project';
  let description = '';
  if (existsSync('.copier-answers.yml')) {
    const a = readFileSync('.copier-answers.yml', 'utf8');
    name = a.match(/^project_name:\s*["']?(.+?)["']?\s*$/m)?.[1] ?? name;
    description = a.match(/^project_description:\s*["']?(.*?)["']?\s*$/m)?.[1] ?? '';
  }

  const front = { version: 'alpha', name };
  if (description) front.description = description;
  if (Object.keys(colors).length) front.colors = colors;
  if (Object.keys(typo).length) front.typography = typo;
  if (Object.keys(rounded).length) front.rounded = rounded;
  if (Object.keys(spacing).length) front.spacing = spacing;

  const table = (head, rows) => [`| ${head.join(' | ')} |`, `| ${head.map(() => '---').join(' | ')} |`, ...rows.map((r) => `| ${r.join(' | ')} |`)].join('\n');
  const list = (obj) => Object.entries(obj).map(([k, v]) => `- \`${k}\`: ${typeof v === 'object' ? Object.entries(v).map(([a, b]) => `${a} ${b}`).join(', ') : v}`).join('\n');

  const body = [
    `<!-- Generated by scripts/design-md.mjs from the token source and ${PACK}/. Do not edit: change the tokens or the pack's answers, then run node scripts/design-md.mjs. -->`,
    '',
    `# ${name}`,
    '',
    '## Overview',
    '',
    description || '_No project description yet._',
    '',
    `Voice and tone: ${said(param('content-and-i18n.md', 'voice_and_tone'))}`,
    '',
    `The design system is defined by the token source and the standards in \`${PACK}/\`; this file is generated from them for agents that read DESIGN.md. Values below are the \`${main}\` theme.`,
    '',
    '## Colors',
    '',
    `Brand roles: ${said(param('design-tokens.md', 'brand_roles'))}. Status roles: ${said(param('design-tokens.md', 'status_roles'))}. Themes: ${themes.map(([t]) => t).join(', ')}.`,
    '',
    colorRows.length ? table(['Token', 'Source path', ...themes.map(([t]) => t)], colorRows.map(([n, p, ...v]) => [`\`${n}\``, `\`${p}\``, ...v])) : '_No colour tokens yet._',
    '',
    '## Typography',
    '',
    Object.keys(typo).length ? list(typo) : '_No typography tokens yet._',
    '',
    `Units: ${said(param('design-tokens.md', 'units'))}`,
    '',
    '## Layout',
    '',
    Object.keys(spacing).length ? list(spacing) : '_No spacing tokens yet._',
    '',
    `Scales: ${said(param('design-tokens.md', 'scales'))}`,
    '',
    '## Elevation & Depth',
    '',
    shadows.length ? shadows.map((s) => `- \`${s}\``).join('\n') : '_No elevation tokens yet._',
    '',
    '## Shapes',
    '',
    Object.keys(rounded).length ? list(rounded) : '_No radius tokens yet._',
    '',
    '## Components',
    '',
    `One component per role: ${said(param('components.md', 'one_component_per_role'))}`,
    '',
    `Inventory: ${said(param('components.md', 'inventory_location'))}`,
    '',
    "## Do's and Don'ts",
    '',
    '- Do reference semantic tokens only; never a primitive or a literal colour, size, duration or stacking value.',
    '- Do map a domain state to a status role through the status map; never pick a colour for a state.',
    '- Do keep each brand role its own token, even when two share a value today.',
    `- Do meet the accessibility target (${said(param('accessibility.md', 'conformance_target'))}), with contrast in every theme of at least ${said(param('accessibility.md', 'contrast_minimum'))}.`,
    `- Do honour the reduced-motion preference: ${said(param('design-tokens.md', 'motion'))}.`,
    "- Don't add a value no token provides: add the token to the source first.",
    "- Don't edit this file: it is regenerated.",
    '',
  ].join('\n');
  return { text: `---\n${yamlMap(front)}\n---\n\n${body}`, path: opts.path ?? 'DESIGN.md' };
}

/** For the check plugin: problems as "path: message" lines. */
export function check() {
  let out;
  try { out = render(); } catch (e) { return [`${CONFIG}: cannot generate DESIGN.md (${e.message})`]; }
  if (out.skip) return [];
  if (!existsSync(out.path)) return [`${out.path}: missing; run node scripts/design-md.mjs`];
  const norm = (s) => s.replace(/\r\n/g, '\n').trimEnd();
  return norm(readFileSync(out.path, 'utf8')) === norm(out.text) ? [] : [`${out.path}: out of date with the token source or the user-interface pack; run node scripts/design-md.mjs (never edit it by hand)`];
}

if (import.meta.url === pathToFileURL(process.argv[1] ?? '').href) {
  if (process.argv.includes('--check')) {
    const problems = check();
    for (const p of problems) console.log(p);
    process.exit(problems.length ? 1 : 0);
  }
  let out;
  try { out = render(); } catch (e) { console.error(`design-md: ${e.message}`); process.exit(1); }
  if (out.skip) { console.log(`design-md: nothing to generate (${out.skip})`); process.exit(0); }
  writeFileSync(out.path, `${out.text}\n`);
  console.log(`design-md: wrote ${out.path}`);
}
